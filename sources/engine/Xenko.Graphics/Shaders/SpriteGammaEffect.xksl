shader SpriteGammaEffect : SpriteBase
{
    stage bool GammaBoost = false;

    // Shading of the sprite
    stage override float4 Shading()
    {
        float4 color = base.Shading();
        if (GammaBoost)
        {
            return ColorUtility.ToLinear(color);
        }
        return color;
    }
};
