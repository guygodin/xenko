shader SpriteEffectExtTextureCube : SpriteEffectExtTexture
{
    stage int StereoMode;

	cbuffer PerDraw
    {
        // -------------------------------------
        // uniforms
        // -------------------------------------
        // A general transformation matrix
        stage float4x4 MatrixTransform;
    }
    
    stage override void VSMain()
    {
        streams.ShadingPosition = mul(streams.Position, MatrixTransform);
    }

    stage override float4 Shading()
    {
		if (StereoMode == 1)
		{
			// Left eye
			streams.TexCoord.x = streams.TexCoord.x / 2;
		}
		else if (StereoMode == 2)
		{
			// Right eye
			streams.TexCoord.x = (streams.TexCoord.x / 2) + 0.5f;
		}
		return base.Shading();
    }
};
