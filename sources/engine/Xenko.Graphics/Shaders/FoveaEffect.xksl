shader FoveaEffect : SpriteEffectExtTexture
{
	stage float2 OneOverTexSize;
    stage float Sharpening = -0.13125f; // 0.0 to -0.175
    stage bool UseSharpening = true;
    stage bool GammaBoost = false;

	stage float3 CAS(in float3 a, in float2 uv, in float strength)
    {
        float b = Texture.Sample(Sampler, uv + float2(-OneOverTexSize.x, 0.0)).r;
        float c = Texture.Sample(Sampler, uv + float2( 0.0, -OneOverTexSize.y)).r;
        float d = Texture.Sample(Sampler, uv + float2( OneOverTexSize.x, 0.0)).r;
        float e = Texture.Sample(Sampler, uv + float2( 0.0,  OneOverTexSize.y)).r;
        float2 minMaxY = float2(min(a.r, min(b, min(c, min(d, e)))), max(a.r, max(b, max(c, max(d, e)))));
        minMaxY.y += 0.0005f;
        float AA = sqrt(min(1.0 - minMaxY.y, minMaxY.x) / minMaxY.y);
        float w = Sharpening * AA * strength;
        return float3((w * (b + c + d + e) + a.r) / (w * 4.0 + 1.0), a.g, a.b);
    }

    stage override float4 Shading()
    {
        float2 uv = streams.TexCoord;

        float dist = length(uv - 0.5);
        float alpha = saturate((0.5 - dist) * 20.0);

        float3 a = Texture.Sample(Sampler, uv).rgb;
        
        if (UseSharpening)
        {
            a = CAS(a, uv, alpha);
        }

        a = YUVToRGB(a);

        if (GammaBoost)
        {
            a = saturate(pow(saturate(a), 1.5));
        }
        return float4(a * alpha, alpha);
    }
};
