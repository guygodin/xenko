shader SharpenEffect : SpriteEffectExtTexture
{
	stage float2 OneOverTexSize;
    stage float Sharpening = -0.13125f; // 0.0 to -0.175
    stage float Radius = 0.75f;
    stage bool GammaBoost = false;

    stage float3 CAS(in float3 a, in float2 uv, in float strength)
    {
        float3 b = Texture.Sample(Sampler, uv + float2(-OneOverTexSize.x, 0.0)).rgb;
        float3 c = Texture.Sample(Sampler, uv + float2( 0.0, -OneOverTexSize.y)).rgb;
        float3 d = Texture.Sample(Sampler, uv + float2( OneOverTexSize.x, 0.0)).rgb;
        float3 e = Texture.Sample(Sampler, uv + float2( 0.0,  OneOverTexSize.y)).rgb;
        float2 minMaxY = float2(min(a.r, min(b.r, min(c.r, min(d.r, e.r)))), max(a.r, max(b.r, max(c.r, max(d.r, e.r)))));
        minMaxY.y += 0.0005f;
        float AA = sqrt(min(1.0 - minMaxY.y, minMaxY.x) / minMaxY.y);
        float w = Sharpening * AA * strength;
        return (w * (b + c + d + e) + a) / (w * 4.0 + 1.0);
    }

    stage override float4 Shading()
    {
        float2 uv = streams.TexCoord;
        float dist = length(uv * 2.0 - 1.0);

        float3 a = Texture.Sample(Sampler, uv).rgb;

        if (dist < Radius)
        {
            float strength = saturate((Radius - dist) * 20.0);
            a = CAS(a, uv, strength);
        }
        
        a = YUVToRGB(a);

        if (GammaBoost)
        {
            a = saturate(pow(saturate(a), 1.5));
        }
        return float4(a, 1.0);
    }
};
