shader AdditiveSpriteEffect : SpriteBase
{
    // Color used to tint the sprite
    [Color]
    stage float4 Color = float4(1,1,1,1);
    stage float BaseIntensity = 1;

    // Shading of the sprite
    stage override float4 Shading()
    {
        float4 baseColor = base.Shading();
        float4 additiveColor = Texture1.Sample(Sampler, streams.TexCoord);
        return (baseColor * BaseIntensity) + (additiveColor * Color);
    }
};
